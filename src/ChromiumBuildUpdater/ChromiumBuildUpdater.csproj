<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ChromiumBuildUpdater</AssemblyName>
    <RootNamespace>ChromiumBuildUpdater</RootNamespace>
    <Version>3.1.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4"/>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChromiumBuildUpdater.Core\ChromiumBuildUpdater.Core.csproj"/>
  </ItemGroup>
</Project>
